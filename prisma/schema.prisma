generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  usersOnProject UserOnProject[]
  comments Comment[]
  tasks Task[]
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt 
}

model Project {
  id Int @id @default(autoincrement())
  name String 
  description String?
  tasks Task[]
  comments Comment[] 
  usersOnProject UserOnProject[]
  dateStart DateTime?
  dateEnd DateTime?
  status Status    @default(NEW)
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt
}

model UserOnProject {
 user User @relation(fields: [userId], references: [id])
 userId Int
 userRole UserRole @default(VIEWER)
 project Project @relation(fields: [projectId], references: [id])
 projectId Int
 @@id([projectId, userId])
}

model Task {
  author User @relation(fields: [authorId], references: [id])
  authorId Int
  project Project @relation(fields: [projectId], references: [id])
  projectId Int
  comments Comment[]
  title String
  description String
  status Status @default(NEW)
  id Int @id @default(autoincrement())
  dateStart DateTime?
  dateEnd DateTime?
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt
} 

model Comment {
  author User @relation(fields: [authorId], references: [id])
  authorId Int
  project Project? @relation(fields: [projectId], references: [id])
  projectId Int?
  task Task? @relation(fields: [taskId], references: [id])
  taskId Int?
  comment String
  id Int @id @default(autoincrement())
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt
}

enum UserRole {
 OWNER
 ADMIN
 TEAMLEAD
 DEVELOPER
 MANAGER
 ANALYST
 VIEWER
}

enum Status { 
  NEW 
  IN_PROCESS
  IN_TESTING
  DONE
  CLOSED
} 